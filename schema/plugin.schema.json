{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kayingai/open-zcode-game-plugins/main/schema/plugin.schema.json",
  "title": "open-zcode-game-plugins plugin entry",
  "description": "One file per plugin at plugins/<name>.json. One PR adds or updates exactly one such file. catalog.json and the README plugin tables are generated from these files — never edit them by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name", "version", "description", "description_i18n", "category", "hosts",
    "author", "license", "repository", "source", "addedAt"
  ],
  "properties": {
    "$schema": { "type": "string", "description": "Relative path or URL to schema/plugin.schema.json (editor autocomplete only)." },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "description": "Stable plugin id. Must equal the file name without .json."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "SemVer of the plugin release listed here."
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "displayName_i18n": { "$ref": "#/$defs/i18n" },
    "description": {
      "type": "string", "minLength": 12, "maxLength": 300,
      "description": "English fallback one-liner, also used by ZCode-compatible marketplaces."
    },
    "description_i18n": { "$ref": "#/$defs/i18n" },
    "category": { "$ref": "#/$defs/category" },
    "marketplaceCategory": {
      "type": "string", "default": "游戏/3D",
      "description": "Category used if this entry is exported to a ZCode-compatible marketplace.json."
    },
    "keywords": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "hosts": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": { "type": "string", "enum": ["zcode", "kayingcode"] },
      "description": "Hosts this plugin ships a package for. source.packages must cover every listed host."
    },
    "author": {
      "type": "object", "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "license": {
      "type": "string", "minLength": 2, "maxLength": 40,
      "description": "SPDX identifier of the plugin's own license (NOT this repository's Apache-2.0)."
    },
    "repository": { "type": "string", "pattern": "^https://" },
    "homepage": { "type": "string", "pattern": "^https://" },
    "icon": { "type": "string", "pattern": "^https://" },
    "examplePrompts": {
      "type": "array", "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "source": { "$ref": "#/$defs/source" },
    "install": { "$ref": "#/$defs/install" },
    "addedAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "notes_i18n": { "$ref": "#/$defs/i18n" }
  },
  "$defs": {
    "i18n": {
      "type": "object", "additionalProperties": false,
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "category": {
      "type": "string",
      "enum": ["game-design", "game-ui", "game-art", "game-engine", "game-content", "game-audio", "game-tooling", "other"]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "packages"],
      "properties": {
        "type": { "type": "string", "enum": ["bundled", "git", "zip"] },
        "repository": {
          "type": "string", "pattern": "^https://",
          "description": "Upstream source repository (informational for bundled, fetch target for git)."
        },
        "ref": {
          "type": "string", "minLength": 4,
          "description": "Immutable commit SHA preferred; tags/branches are accepted but weaker."
        },
        "packages": {
          "type": "object", "minProperties": 1, "maxProperties": 2,
          "additionalProperties": false,
          "properties": {
            "zcode": { "$ref": "#/$defs/package" },
            "kayingcode": { "$ref": "#/$defs/package" }
          }
        }
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "marketplace", "pluginManifest"],
      "properties": {
        "path": {
          "type": "string", "minLength": 1,
          "description": "bundled: repo-relative dir; git: dir inside the cloned repo; zip: dir inside the archive."
        },
        "marketplace": {
          "type": "string", "default": "marketplace.json",
          "description": "Path relative to the package directory: the marketplace.json used to register a local source."
        },
        "pluginManifest": {
          "type": "string",
          "description": "Path relative to the package directory, e.g. .zcode-plugin/plugin.json."
        },
        "url": {
          "type": "string", "pattern": "^https://",
          "description": "Required when source.type is zip: immutable HTTPS URL of the archive."
        },
        "sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$",
          "description": "Required when source.type is zip: lowercase SHA-256 of the archive."
        },
        "licenseFile": { "type": "string", "default": "LICENSE" },
        "noticeFile": { "type": "string", "default": "NOTICE" }
      }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string", "enum": ["local-marketplace", "plugin-dir", "manual"],
          "default": "local-marketplace"
        },
        "notes_i18n": { "$ref": "#/$defs/i18n" },
        "requires": {
          "type": "array", "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    }
  }
}
